-- Trigger 2: Khi cập nhật ngày trả thực tế, trả trạng thái cuốn sách về 'Có sẵn'
CREATE OR ALTER TRIGGER trg_CapNhatTrangThaiTraSach
ON ChiTietPhieuMuon
AFTER UPDATE
AS
BEGIN
    SET NOCOUNT ON;

    IF UPDATE(NgayTraThucTe)
    BEGIN
        UPDATE cs
        SET cs.TrangThaiMuon = N'Có sẵn'
        FROM CuonSach cs
        JOIN inserted i ON cs.MaCuonSach = i.MaCuonSach
        JOIN deleted d ON i.MaChiTiet = d.MaChiTiet
        WHERE i.NgayTraThucTe IS NOT NULL AND d.NgayTraThucTe IS NULL;
    END
END;
