--4 Views
-- View 1: Danh mục sách đầy đủ kèm thể loại, NXB và danh sách tác giả
CREATE OR ALTER VIEW vw_ThongTinDauSachChiTiet
AS
SELECT 
    ds.MaDauSach,
    ds.TenDauSach,
    tl.TenTheLoai,
    nxb.TenNhaXuatBan,
    ds.NamXuatBan,
    STRING_AGG(tg.TenTacGia, ', ') AS DanhSachTacGia,
    COUNT(cs.MaCuonSach) AS TongSoBanSao,
    SUM(CASE WHEN cs.TrangThaiMuon = N'Có sẵn' THEN 1 ELSE 0 END) AS SoBanSanSang
FROM DauSach ds
LEFT JOIN TheLoai tl ON ds.MaTheLoai = tl.MaTheLoai
LEFT JOIN NhaXuatBan nxb ON ds.MaNhaXuatBan = nxb.MaNhaXuatBan
LEFT JOIN Sach_TacGia stg ON ds.MaDauSach = stg.MaDauSach
LEFT JOIN TacGia tg ON stg.MaTacGia = tg.MaTacGia
LEFT JOIN CuonSach cs ON ds.MaDauSach = cs.MaDauSach
GROUP BY 
    ds.MaDauSach, ds.TenDauSach, tl.TenTheLoai, nxb.TenNhaXuatBan, ds.NamXuatBan;
GO
-- Test View 1: Xem thông tin đầy đủ các đầu sách, NXB, danh sách tác giả và số bản khả dụng
