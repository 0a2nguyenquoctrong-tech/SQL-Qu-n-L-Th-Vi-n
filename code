-- Stored Procedure 2: Trả sách và tự động tạo phiếu phạt nếu trả quá hạn
CREATE OR ALTER PROCEDURE sp_TraSach
    @MaPhieuMuon INT,
    @MaCuonSach INT,
    @MaNhanVien INT,
    @TinhTrangKhiTra NVARCHAR(100) = N'Bình thường'
AS
BEGIN
    SET NOCOUNT ON;
    BEGIN TRY
        BEGIN TRANSACTION;

        DECLARE @HanTra DATETIME;
        DECLARE @NgayHienTai DATETIME = GETDATE();

        SELECT @HanTra = HanTra FROM PhieuMuon WHERE MaPhieuMuon = @MaPhieuMuon;

        IF @HanTra IS NULL
        BEGIN
            RAISERROR(N'Phiếu mượn không tồn tại!', 16, 1);
        END

        -- Cập nhật ngày trả thực tế
        UPDATE ChiTietPhieuMuon
        SET NgayTraThucTe = @NgayHienTai,
            TinhTrangSachKhiTra = @TinhTrangKhiTra
        WHERE MaPhieuMuon = @MaPhieuMuon AND MaCuonSach = @MaCuonSach;

        -- Nếu trả trễ hạn, phạt 5,000 VND / ngày trễ
        IF @NgayHienTai > @HanTra
        BEGIN
            DECLARE @SoNgayTre INT = DATEDIFF(DAY, @HanTra, @NgayHienTai);
            DECLARE @TienPhat DECIMAL(18,2) = @SoNgayTre * 5000;

            INSERT INTO PhieuPhat (MaPhieuMuon, MaNhanVien, NgayLap, NoiDungPhat, TongTienPhat, TrangThaiThanhToan)
            VALUES (@MaPhieuMuon, @MaNhanVien, @NgayHienTai, 
                    N'Trả trễ hạn ' + CAST(@SoNgayTre AS VARCHAR(10)) + N' ngày', @TienPhat, 0);
        END

        COMMIT TRANSACTION;
        PRINT N'Xử lý trả sách hoàn tất.';
    END TRY
    BEGIN CATCH
        IF @@TRANCOUNT > 0 ROLLBACK TRANSACTION;
        THROW;
    END CATCH
END;
GO
