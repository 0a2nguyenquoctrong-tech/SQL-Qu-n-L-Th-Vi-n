-- Stored Procedure 3: Cấp mới hoặc gia hạn thẻ độc giả thêm số tháng chỉ định
CREATE OR ALTER PROCEDURE sp_GiaHanTheDocGia
    @MaThe INT,
    @SoThangGiaHan INT = 12,
    @LePhi DECIMAL(18,2) = 50000
AS
BEGIN
    SET NOCOUNT ON;

    IF NOT EXISTS (SELECT 1 FROM TheDocGia WHERE MaThe = @MaThe)
    BEGIN
        RAISERROR(N'Thẻ độc giả không tồn tại!', 16, 1);
        RETURN;
    END

    UPDATE TheDocGia
    SET NgayHetHan = DATEADD(MONTH, @SoThangGiaHan, 
                        CASE WHEN NgayHetHan > CAST(GETDATE() AS DATE) 
                             THEN NgayHetHan 
                             ELSE CAST(GETDATE() AS DATE) 
                        END),
        LePhi = LePhi + @LePhi,
        TrangThai = 1
    WHERE MaThe = @MaThe;

    PRINT N'Gia hạn thẻ thành công.';
END;
GO
