-- Function 1 (Scalar): Đếm số sách đang mượn của một độc giả
CREATE OR ALTER FUNCTION fn_DemSachDangMuon (@MaDocGia INT)
RETURNS INT
AS
BEGIN
    DECLARE @SoLuong INT;

    SELECT @SoLuong = COUNT(ct.MaChiTiet)
    FROM ChiTietPhieuMuon ct
    JOIN PhieuMuon pm ON ct.MaPhieuMuon = pm.MaPhieuMuon
    JOIN TheDocGia tdg ON pm.MaThe = tdg.MaThe
    WHERE tdg.MaDocGia = @MaDocGia
      AND ct.NgayTraThucTe IS NULL;

    RETURN ISNULL(@SoLuong, 0);
END;
GO
