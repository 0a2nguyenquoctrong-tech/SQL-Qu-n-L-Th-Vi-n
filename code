Go
-- View 2: Danh sách các phiếu mượn đang quá hạn và độc giả tương ứng
CREATE OR ALTER VIEW vw_SachMuonQuaHan
AS
SELECT 
    pm.MaPhieuMuon,
    dg.HoTen AS TenDocGia,
    dg.SoDienThoai,
    dg.Email,
    ds.TenDauSach,
    cs.MaCuonSach,
    pm.NgayMuon,
    pm.HanTra,
    DATEDIFF(DAY, pm.HanTra, GETDATE()) AS SoNgayQuaHan
FROM PhieuMuon pm
JOIN TheDocGia tdg ON pm.MaThe = tdg.MaThe
JOIN DocGia dg ON tdg.MaDocGia = dg.MaDocGia
JOIN ChiTietPhieuMuon ct ON pm.MaPhieuMuon = ct.MaPhieuMuon
JOIN CuonSach cs ON ct.MaCuonSach = cs.MaCuonSach
JOIN DauSach ds ON cs.MaDauSach = ds.MaDauSach
WHERE ct.NgayTraThucTe IS NULL 
  AND GETDATE() > pm.HanTra;
GO
-- Test View 2: Xem các lượt mượn sách đang bị trễ hạn cùng thông tin độc giả
SELECT * FROM vw_SachMuonQuaHan;
Go
-- View 3: Lịch sử mượn trả chi tiết của độc giả
CREATE OR ALTER VIEW vw_LichSuMuonTra
AS
SELECT 
    ct.MaChiTiet,
    pm.MaPhieuMuon,
    dg.HoTen AS TenDocGia,
    tdg.MaThe,
    ds.TenDauSach,
    cs.MaCuonSach,
    pm.NgayMuon,
    pm.HanTra,
    ct.NgayTraThucTe,
    nv.HoTen AS NhanVienLapPhieu,
    CASE 
        WHEN ct.NgayTraThucTe IS NOT NULL THEN N'Đã trả'
        WHEN GETDATE() > pm.HanTra THEN N'Quá hạn chưa trả'
        ELSE N'Đang mượn'
    END AS TrangThaiHienTai
FROM ChiTietPhieuMuon ct
JOIN PhieuMuon pm ON ct.MaPhieuMuon = pm.MaPhieuMuon
JOIN TheDocGia tdg ON pm.MaThe = tdg.MaThe
JOIN DocGia dg ON tdg.MaDocGia = dg.MaDocGia
JOIN CuonSach cs ON ct.MaCuonSach = cs.MaCuonSach
JOIN DauSach ds ON cs.MaDauSach = ds.MaDauSach
JOIN NhanVien nv ON pm.MaNhanVien = nv.MaNhanVien;
GO
-- Test View 3: Xem toàn bộ lịch sử và trạng thái mượn trả
SELECT * FROM vw_LichSuMuonTra;
Go
-- View 4: Thống kê tiền phạt chưa thanh toán theo độc giả
CREATE OR ALTER VIEW vw_ThongKePhatChuaThu
AS
SELECT 
    dg.MaDocGia,
    dg.HoTen AS TenDocGia,
    dg.SoDienThoai,
    COUNT(pp.MaPhieuPhat) AS SoLanPhatChuaTra,
    SUM(pp.TongTienPhat) AS TongTienNoPhat
FROM PhieuPhat pp
JOIN PhieuMuon pm ON pp.MaPhieuMuon = pm.MaPhieuMuon
JOIN TheDocGia tdg ON pm.MaThe = tdg.MaThe
JOIN DocGia dg ON tdg.MaDocGia = dg.MaDocGia
WHERE pp.TrangThaiThanhToan = 0
GROUP BY dg.MaDocGia, dg.HoTen, dg.SoDienThoai;
GO
