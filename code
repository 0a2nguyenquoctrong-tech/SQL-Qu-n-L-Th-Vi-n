-- Stored Procedure 4: Thống kê số lượng sách được mượn theo từng thể loại trong năm chỉ định
CREATE OR ALTER PROCEDURE sp_ThongKeMuonSachTheoTheLoai
    @Nam INT
AS
BEGIN
    SET NOCOUNT ON;

    SELECT 
        tl.MaTheLoai,
        tl.TenTheLoai,
        COUNT(ct.MaChiTiet) AS SoLuotMuon
    FROM TheLoai tl
    LEFT JOIN DauSach ds ON tl.MaTheLoai = ds.MaTheLoai
    LEFT JOIN CuonSach cs ON ds.MaDauSach = cs.MaDauSach
    LEFT JOIN ChiTietPhieuMuon ct ON cs.MaCuonSach = ct.MaCuonSach
    LEFT JOIN PhieuMuon pm ON ct.MaPhieuMuon = pm.MaPhieuMuon AND YEAR(pm.NgayMuon) = @Nam
    GROUP BY tl.MaTheLoai, tl.TenTheLoai
    ORDER BY SoLuotMuon DESC;
END;
GO
