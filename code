-- Function 4 (Table-Valued): Báo cáo chi tiết mượn sách theo khoảng thời gian
CREATE OR ALTER FUNCTION fn_BaoCaoMuonSachTheoKhoangTG (
    @TuNgay DATETIME, 
    @DenNgay DATETIME
)
RETURNS TABLE
AS
RETURN (
    SELECT 
        pm.MaPhieuMuon,
        dg.HoTen AS TenDocGia,
        ds.TenDauSach,
        pm.NgayMuon,
        pm.HanTra,
        ct.NgayTraThucTe,
        pm.TrangThai AS TrangThaiPhieu
    FROM PhieuMuon pm
    JOIN TheDocGia tdg ON pm.MaThe = tdg.MaThe
    JOIN DocGia dg ON tdg.MaDocGia = dg.MaDocGia
    JOIN ChiTietPhieuMuon ct ON pm.MaPhieuMuon = ct.MaPhieuMuon
    JOIN CuonSach cs ON ct.MaCuonSach = cs.MaCuonSach
    JOIN DauSach ds ON cs.MaDauSach = ds.MaDauSach
    WHERE pm.NgayMuon BETWEEN @TuNgay AND @DenNgay
);
GO
