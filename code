-- Function 2 (Scalar): Tính tổng tiền phạt chưa nộp của một độc giả
CREATE OR ALTER FUNCTION fn_TinhTienPhatChuaNop (@MaDocGia INT)
RETURNS DECIMAL(18,2)
AS
BEGIN
    DECLARE @TongTien DECIMAL(18,2);

    SELECT @TongTien = SUM(pp.TongTienPhat)
    FROM PhieuPhat pp
    JOIN PhieuMuon pm ON pp.MaPhieuMuon = pm.MaPhieuMuon
    JOIN TheDocGia tdg ON pm.MaThe = tdg.MaThe
    WHERE tdg.MaDocGia = @MaDocGia
      AND pp.TrangThaiThanhToan = 0;

    RETURN ISNULL(@TongTien, 0);
END;
GO
