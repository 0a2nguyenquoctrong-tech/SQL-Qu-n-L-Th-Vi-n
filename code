-- Trigger 1: Tự động đổi trạng thái cuốn sách thành 'Đang mượn' khi thêm vào ChiTietPhieuMuon
CREATE OR ALTER TRIGGER trg_CapNhatTrangThaiMuonSach
ON ChiTietPhieuMuon
AFTER INSERT
AS
BEGIN
    SET NOCOUNT ON;

    -- Kiểm tra nếu sách đang mượn hoặc đã mất thì hủy thao tác
    IF EXISTS (
        SELECT 1 
        FROM CuonSach cs 
        JOIN inserted i ON cs.MaCuonSach = i.MaCuonSach
        WHERE cs.TrangThaiMuon <> N'Có sẵn'
    )
    BEGIN
        RAISERROR(N'Cuốn sách được chọn hiện không có sẵn để mượn!', 16, 1);
        ROLLBACK TRANSACTION;
        RETURN;
    END

    UPDATE CuonSach
    SET TrangThaiMuon = N'Đang mượn'
    WHERE MaCuonSach IN (SELECT MaCuonSach FROM inserted);
END;
GO
