-- Trigger 4: Tự động đổi trạng thái Phiếu mượn thành 'Đã trả đủ' khi mọi cuốn sách trong phiếu đã có ngày trả
CREATE OR ALTER TRIGGER trg_DongPhieuMuonKhiTraHet
ON ChiTietPhieuMuon
AFTER UPDATE
AS
BEGIN
    SET NOCOUNT ON;

    UPDATE pm
    SET TrangThai = N'Đã trả đủ'
    FROM PhieuMuon pm
    WHERE pm.MaPhieuMuon IN (SELECT DISTINCT MaPhieuMuon FROM inserted)
      AND NOT EXISTS (
          SELECT 1 
          FROM ChiTietPhieuMuon ct 
          WHERE ct.MaPhieuMuon = pm.MaPhieuMuon 
            AND ct.NgayTraThucTe IS NULL
      );
END;
GO
