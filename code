GO
-- Chạy định kỳ: phiếu đang mượn, còn sách chưa trả, đã quá hạn -> 'Quá hạn'
UPDATE pm
SET TrangThai = N'Quá hạn'
FROM PhieuMuon pm
WHERE pm.TrangThai = N'Đang mượn'
  AND pm.HanTra < GETDATE()
  AND EXISTS (
      SELECT 1
      FROM ChiTietPhieuMuon ct
      WHERE ct.MaPhieuMuon = pm.MaPhieuMuon
        AND ct.NgayTraThucTe IS NULL
  );
GO
-- Stored Procedure 1: Mượn sách an toàn (sử dụng Transaction kiểm soát nghiệp vụ)
CREATE OR ALTER PROCEDURE sp_TaoPhieuMuon
    @MaThe INT,
    @MaNhanVien INT,
    @MaCuonSach INT,
    @SoNgayMuon INT = 14
AS
BEGIN
    SET NOCOUNT ON;
    BEGIN TRY
        BEGIN TRANSACTION;

        -- 1. Kiểm tra sách có sẵn không
        IF NOT EXISTS (SELECT 1 FROM CuonSach WHERE MaCuonSach = @MaCuonSach AND TrangThaiMuon = N'Có sẵn')
        BEGIN
            RAISERROR(N'Cuốn sách này không có sẵn để mượn!', 16, 1);
        END

        -- 2. Tạo phiếu mượn
        DECLARE @MaPhieuMuon INT;
        DECLARE @HanTra DATETIME = DATEADD(DAY, @SoNgayMuon, GETDATE());

        INSERT INTO PhieuMuon (MaThe, MaNhanVien, NgayMuon, HanTra, TrangThai)
        VALUES (@MaThe, @MaNhanVien, GETDATE(), @HanTra, N'Đang mượn');

        SET @MaPhieuMuon = SCOPE_IDENTITY();

        -- 3. Thêm chi tiết (Trigger trg_CapNhatTrangThaiMuonSach sẽ cập nhật CuonSach thành 'Đang mượn')
        INSERT INTO ChiTietPhieuMuon (MaPhieuMuon, MaCuonSach, TinhTrangSachKhiMuon)
        VALUES (@MaPhieuMuon, @MaCuonSach, N'Bình thường');

        COMMIT TRANSACTION;
        PRINT N'Tạo phiếu mượn thành công. Mã phiếu: ' + CAST(@MaPhieuMuon AS VARCHAR(10));
    END TRY
    BEGIN CATCH
        IF @@TRANCOUNT > 0 ROLLBACK TRANSACTION;
        THROW;
    END CATCH
END;
GO
-- Test Procedure 1: Tạo phiếu mượn mới thông qua Stored Procedure
-- 1. Cập nhật hạn thẻ cho tất cả các thẻ đang hoạt động (ví dụ cộng thêm 5 năm kể từ hôm nay)
UPDATE TheDocGia
SET NgayHetHan = DATEADD(YEAR, 5, CAST(GETDATE() AS DATE))
WHERE TrangThai = 1;
GO

