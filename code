-- Function 3 (Inline Table-Valued): Tra cứu sách có sẵn theo từ khóa tên sách/tác giả
CREATE OR ALTER FUNCTION fn_TraCuuSachKhaDung (@TuKhoa NVARCHAR(100))
RETURNS TABLE
AS
RETURN (
    SELECT 
        ds.MaDauSach,
        ds.TenDauSach,
        tl.TenTheLoai,
        cs.MaCuonSach,
        cs.TinhTrang,
        cs.TrangThaiMuon
    FROM DauSach ds
    JOIN CuonSach cs ON ds.MaDauSach = cs.MaDauSach
    LEFT JOIN TheLoai tl ON ds.MaTheLoai = tl.MaTheLoai
    WHERE cs.TrangThaiMuon = N'Có sẵn'
      AND ds.TenDauSach LIKE N'%' + @TuKhoa + N'%'
);
GO
