CREATE DATABASE QuanLyThuVienTPHCM;GO
USE QuanLyThuVienTPHCM;GO
-- 1. Bảng Nhân Viên (Thủ thư, quản lý)
CREATE TABLE NhanVien (
    MaNhanVien INT IDENTITY(1,1) PRIMARY KEY,
    HoTen NVARCHAR(100) NOT NULL,
    Phai NVARCHAR(10) CHECK (Phai IN (N'Nam', N'Nữ', N'Khác')),
    NgaySinh DATE NULL,
    ChucVu NVARCHAR(50) NOT NULL,
    SoDienThoai VARCHAR(15) UNIQUE NOT NULL,
    Email VARCHAR(100) UNIQUE NULL,
    TenDangNhap VARCHAR(50) UNIQUE NOT NULL,
    MatKhau VARCHAR(255) NOT NULL,
    TrangThai BIT DEFAULT 1 -- 1: Đang làm việc, 0: Nghỉ việc
);
GO

-- 2. Bảng Thể Loại Sách
CREATE TABLE TheLoai (
    MaTheLoai INT IDENTITY(1,1) PRIMARY KEY,
    TenTheLoai NVARCHAR(100) NOT NULL,
    MoTa NVARCHAR(255) NULL
);
GO

-- 3. Bảng Nhà Xuất Bản
CREATE TABLE NhaXuatBan (
    MaNhaXuatBan INT IDENTITY(1,1) PRIMARY KEY,
    TenNhaXuatBan NVARCHAR(150) NOT NULL,
    DiaChi NVARCHAR(255) NULL,
    SoDienThoai VARCHAR(15) NULL
);
GO

-- 4. Bảng Tác Giả
CREATE TABLE TacGia (
    MaTacGia INT IDENTITY(1,1) PRIMARY KEY,
    TenTacGia NVARCHAR(100) NOT NULL,
    TieuSu NVARCHAR(MAX) NULL
);
GO

-- 5. Bảng Đầu Sách (Thông tin chung về ấn phẩm)
CREATE TABLE DauSach (
    MaDauSach INT IDENTITY(1,1) PRIMARY KEY,
    TenDauSach NVARCHAR(200) NOT NULL,
    MaTheLoai INT NULL,
    MaNhaXuatBan INT NULL,
    NamXuatBan INT CHECK (NamXuatBan <= YEAR(GETDATE())),
    CONSTRAINT FK_DauSach_TheLoai FOREIGN KEY (MaTheLoai) REFERENCES TheLoai(MaTheLoai) ON DELETE SET NULL,
    CONSTRAINT FK_DauSach_NhaXuatBan FOREIGN KEY (MaNhaXuatBan) REFERENCES NhaXuatBan(MaNhaXuatBan) ON DELETE SET NULL
);
GO

-- 6. Bảng Liên Kết Đầu Sách - Tác Giả (Quan hệ N - N)
CREATE TABLE Sach_TacGia (
    MaDauSach INT NOT NULL,
    MaTacGia INT NOT NULL,
    PRIMARY KEY (MaDauSach, MaTacGia),
    CONSTRAINT FK_SachTacGia_DauSach FOREIGN KEY (MaDauSach) REFERENCES DauSach(MaDauSach) ON DELETE CASCADE,
    CONSTRAINT FK_SachTacGia_TacGia FOREIGN KEY (MaTacGia) REFERENCES TacGia(MaTacGia) ON DELETE CASCADE
);
GO

-- 7. Bảng Cuốn Sách Vật Lý (Các bản sao cụ thể của từng đầu sách)
CREATE TABLE CuonSach (
    MaCuonSach INT IDENTITY(1,1) PRIMARY KEY,
    MaDauSach INT NOT NULL,
    TinhTrang NVARCHAR(100) DEFAULT N'Mới', -- Mới, Cũ, Hỏng nhẹ, Cần thanh lý...
    TrangThaiMuon NVARCHAR(50) DEFAULT N'Có sẵn' 
        CHECK (TrangThaiMuon IN (N'Có sẵn', N'Đang mượn', N'Đã mất', N'Bảo trì')),
    CONSTRAINT FK_CuonSach_DauSach FOREIGN KEY (MaDauSach) REFERENCES DauSach(MaDauSach) ON DELETE CASCADE
);
GO

-- 8. Bảng Độc Giả (Thông tin cá nhân)
CREATE TABLE DocGia (
    MaDocGia INT IDENTITY(1,1) PRIMARY KEY,
    HoTen NVARCHAR(100) NOT NULL,
    NgaySinh DATE NULL,
    GioiTinh NVARCHAR(10) CHECK (GioiTinh IN (N'Nam', N'Nữ', N'Khác')),
    DiaChi NVARCHAR(255) NULL,
    SoDienThoai VARCHAR(15) UNIQUE NOT NULL,
    Email VARCHAR(100) UNIQUE NULL
);
GO

-- 9. Bảng Thẻ Độc Giả (1 độc giả có thể có các kỳ gia hạn/cấp lại thẻ)
CREATE TABLE TheDocGia (
    MaThe INT IDENTITY(1,1) PRIMARY KEY,
    MaDocGia INT NOT NULL,
    NgayCap DATE DEFAULT CAST(GETDATE() AS DATE),
    NgayHetHan DATE NOT NULL,
    LePhi DECIMAL(18,2) DEFAULT 0,
    TrangThai BIT DEFAULT 1, -- 1: Đang hoạt động, 0: Khóa/Hết hạn
    CONSTRAINT FK_TheDocGia_DocGia FOREIGN KEY (MaDocGia) REFERENCES DocGia(MaDocGia) ON DELETE CASCADE,
    CONSTRAINT CK_NgayHetHan CHECK (NgayHetHan > NgayCap)
);
GO

-- 10. Bảng Phiếu Mượn (Được lập qua Thẻ Độc Giả và Nhân Viên xử lý)
CREATE TABLE PhieuMuon (
    MaPhieuMuon INT IDENTITY(1,1) PRIMARY KEY,
    MaThe INT NOT NULL,
    MaNhanVien INT NOT NULL,
    NgayMuon DATETIME DEFAULT GETDATE(),
    HanTra DATETIME NOT NULL,
    TrangThai NVARCHAR(50) DEFAULT N'Đang mượn' 
        CHECK (TrangThai IN (N'Đang mượn', N'Đã trả đủ', N'Quá hạn')),
    CONSTRAINT FK_PhieuMuon_TheDocGia FOREIGN KEY (MaThe) REFERENCES TheDocGia(MaThe),
    CONSTRAINT FK_PhieuMuon_NhanVien FOREIGN KEY (MaNhanVien) REFERENCES NhanVien(MaNhanVien),
    CONSTRAINT CK_HanTra CHECK (HanTra >= NgayMuon)
);
GO

-- 11. Bảng Chi Tiết Phiếu Mượn (Nhiều cuốn sách trong 1 lần mượn)
CREATE TABLE ChiTietPhieuMuon (
    MaChiTiet INT IDENTITY(1,1) PRIMARY KEY,
    MaPhieuMuon INT NOT NULL,
    MaCuonSach INT NOT NULL,
    NgayTraThucTe DATETIME NULL,
    TinhTrangSachKhiMuon NVARCHAR(100) DEFAULT N'Nguyên vẹn',
    TinhTrangSachKhiTra NVARCHAR(100) NULL,
    CONSTRAINT FK_CTPM_PhieuMuon FOREIGN KEY (MaPhieuMuon) REFERENCES PhieuMuon(MaPhieuMuon) ON DELETE CASCADE,
    CONSTRAINT FK_CTPM_CuonSach FOREIGN KEY (MaCuonSach) REFERENCES CuonSach(MaCuonSach),
    CONSTRAINT UQ_PhieuMuon_CuonSach UNIQUE (MaPhieuMuon, MaCuonSach)
);
GO

-- 12. Bảng Phiếu Phạt (Lập khi phiếu mượn phát sinh vi phạm)
CREATE TABLE PhieuPhat (
    MaPhieuPhat INT IDENTITY(1,1) PRIMARY KEY,
    MaPhieuMuon INT NOT NULL,
    MaNhanVien INT NOT NULL,
    NgayLap DATETIME DEFAULT GETDATE(),
    NoiDungPhat NVARCHAR(MAX) NOT NULL, -- Diễn giải: Trễ hạn, làm mất sách mã X, làm hỏng bìa...
    TongTienPhat DECIMAL(18,2) DEFAULT 0 CHECK (TongTienPhat >= 0),
    TrangThaiThanhToan BIT DEFAULT 0, -- 0: Chưa nộp, 1: Đã nộp
    CONSTRAINT FK_PhieuPhat_PhieuMuon FOREIGN KEY (MaPhieuMuon) REFERENCES PhieuMuon(MaPhieuMuon),
    CONSTRAINT FK_PhieuPhat_NhanVien FOREIGN KEY (MaNhanVien) REFERENCES NhanVien(MaNhanVien)
);
GO
